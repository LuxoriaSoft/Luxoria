<Page
    x:Class="LuxBenchmark.Components.DashboardMain"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="#1A1A1A">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Padding="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="16" Margin="0,0,0,16">
                <TextBlock Text="Benchmark Dashboard"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="White"/>
                <TextBlock x:Name="ComparisonStatusText"
                           FontSize="14"
                           Foreground="Gray"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Gauge Cards Row -->
            <ScrollViewer Grid.Row="1"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled"
                          Margin="0,0,0,16">
                <StackPanel x:Name="GaugeCardsPanel"
                            Orientation="Horizontal"
                            Spacing="12"/>
            </ScrollViewer>

            <!-- Metric Cards Row -->
            <ScrollViewer Grid.Row="2"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled"
                          Margin="0,0,0,16">
                <StackPanel x:Name="MetricCardsPanel"
                            Orientation="Horizontal"
                            Spacing="12"/>
            </ScrollViewer>

            <!-- Main Charts Area Row 1 (3 columns: Bar, Pie, Gauge) -->
            <Grid Grid.Row="3" Height="320" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Performance Bar Chart -->
                <Border Grid.Column="0"
                        Background="#252525"
                        CornerRadius="8"
                        Margin="0,0,8,0">
                    <ContentControl x:Name="PerformanceChartHost"/>
                </Border>

                <!-- Time Distribution Pie Chart -->
                <Border Grid.Column="1"
                        Background="#252525"
                        CornerRadius="8"
                        Margin="8,0,8,0">
                    <ContentControl x:Name="TimeDistributionChartHost"/>
                </Border>

                <!-- Primary Gauge Chart -->
                <Border Grid.Column="2"
                        Background="#252525"
                        CornerRadius="8"
                        Margin="8,0,0,0">
                    <ContentControl x:Name="PrimaryGaugeHost"/>
                </Border>
            </Grid>

            <!-- Charts Area Row 2 (3 columns: Memory, Histogram, BoxPlot) -->
            <Grid Grid.Row="4" Height="320" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Memory Bar Chart -->
                <Border Grid.Column="0"
                        Background="#252525"
                        CornerRadius="8"
                        Margin="0,0,8,0">
                    <ContentControl x:Name="MemoryChartHost"/>
                </Border>

                <!-- Histogram Chart -->
                <Border Grid.Column="1"
                        Background="#252525"
                        CornerRadius="8"
                        Margin="8,0,8,0">
                    <ContentControl x:Name="HistogramChartHost"/>
                </Border>

                <!-- Box Plot Chart -->
                <Border Grid.Column="2"
                        Background="#252525"
                        CornerRadius="8"
                        Margin="8,0,0,0">
                    <ContentControl x:Name="BoxPlotChartHost"/>
                </Border>
            </Grid>

            <!-- Charts Area Row 3 (2 columns: Timeline with Confidence, Scatter Plot) -->
            <Grid Grid.Row="5" Height="340" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Timeline with Confidence Bands -->
                <Border Grid.Column="0"
                        Background="#252525"
                        CornerRadius="8"
                        Margin="0,0,8,0">
                    <ContentControl x:Name="ConfidenceBandChartHost"/>
                </Border>

                <!-- Scatter Plot (Session Comparison) -->
                <Border Grid.Column="1"
                        Background="#252525"
                        CornerRadius="8"
                        Margin="8,0,0,0">
                    <ContentControl x:Name="ScatterPlotHost"/>
                </Border>
            </Grid>

            <!-- Waterfall Chart (Full Width) -->
            <Border Grid.Row="6"
                    Background="#252525"
                    CornerRadius="8"
                    Height="320"
                    Margin="0,0,0,16">
                <ContentControl x:Name="WaterfallChartHost"/>
            </Border>

            <!-- Comparison Table -->
            <Border Grid.Row="7"
                    Background="#252525"
                    CornerRadius="8"
                    Margin="0,0,0,16"
                    MaxHeight="250">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Detailed Comparison"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="White"
                               Margin="16,12,16,8"/>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  Padding="8,0,8,8">
                        <StackPanel x:Name="ComparisonTablePanel"
                                    Orientation="Vertical"
                                    Spacing="2"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Empty State -->
            <StackPanel x:Name="EmptyStatePanel"
                        Grid.Row="0"
                        Grid.RowSpan="8"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                <FontIcon Glyph="&#xE9F9;"
                          FontSize="64"
                          Foreground="Gray"/>
                <TextBlock Text="No benchmark data loaded"
                           FontSize="18"
                           Foreground="Gray"
                           HorizontalAlignment="Center"
                           Margin="0,16,0,8"/>
                <TextBlock Text="Select sessions from the left panel to compare"
                           FontSize="12"
                           Foreground="DarkGray"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
