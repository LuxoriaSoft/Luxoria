<Page
    x:Class="LuxBenchmark.Components.SummaryBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="#1E1E1E">

    <Grid Padding="16,8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Status indicator -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
            <Ellipse x:Name="StatusIndicator"
                     Width="10"
                     Height="10"
                     Fill="#4CAF50"
                     Margin="0,0,8,0"/>
            <TextBlock x:Name="StatusText"
                       Text="Ready"
                       Foreground="White"
                       FontSize="12"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Spacer -->
        <Border Grid.Column="1"/>

        <!-- Quick Stats -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="24" VerticalAlignment="Center">
            <!-- Sessions loaded -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="&#xE8F1;" FontSize="14" Foreground="Gray"/>
                <TextBlock x:Name="SessionsCountText"
                           Text="0 sessions"
                           Foreground="Gray"
                           FontSize="12"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Total samples -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="&#xE9D9;" FontSize="14" Foreground="Gray"/>
                <TextBlock x:Name="TotalSamplesText"
                           Text="0 samples"
                           Foreground="Gray"
                           FontSize="12"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </StackPanel>

        <!-- Divider -->
        <Border Grid.Column="3"
                Width="1"
                Background="#444444"
                Margin="16,4"/>

        <!-- Comparison Summary -->
        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
            <!-- Faster operations -->
            <StackPanel Orientation="Horizontal" Spacing="6">
                <FontIcon Glyph="&#xE74A;" FontSize="14" Foreground="#4CAF50"/>
                <TextBlock x:Name="FasterCountText"
                           Text="0"
                           Foreground="#4CAF50"
                           FontSize="12"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <TextBlock Text="faster"
                           Foreground="Gray"
                           FontSize="12"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Slower operations -->
            <StackPanel Orientation="Horizontal" Spacing="6">
                <FontIcon Glyph="&#xE74B;" FontSize="14" Foreground="#F44336"/>
                <TextBlock x:Name="SlowerCountText"
                           Text="0"
                           Foreground="#F44336"
                           FontSize="12"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <TextBlock Text="slower"
                           Foreground="Gray"
                           FontSize="12"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Unchanged operations -->
            <StackPanel Orientation="Horizontal" Spacing="6">
                <FontIcon Glyph="&#xE8FB;" FontSize="14" Foreground="Gray"/>
                <TextBlock x:Name="UnchangedCountText"
                           Text="0"
                           Foreground="Gray"
                           FontSize="12"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <TextBlock Text="unchanged"
                           Foreground="Gray"
                           FontSize="12"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </StackPanel>

        <!-- Divider -->
        <Border Grid.Column="5"
                Width="1"
                Background="#444444"
                Margin="16,4"/>

        <!-- Overall Improvement -->
        <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <TextBlock Text="Overall:"
                       Foreground="Gray"
                       FontSize="12"
                       VerticalAlignment="Center"/>
            <TextBlock x:Name="OverallImprovementText"
                       Text="—"
                       FontSize="14"
                       FontWeight="Bold"
                       VerticalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Page>
