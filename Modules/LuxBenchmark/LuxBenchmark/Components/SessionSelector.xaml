<Page
    x:Class="LuxBenchmark.Components.SessionSelector"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="#252525">

    <Grid Padding="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0"
                   Text="Sessions"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Foreground="White"
                   Margin="0,0,0,12"/>

        <!-- Load Buttons -->
        <StackPanel Grid.Row="1" Spacing="8" Margin="0,0,0,12">
            <Button x:Name="LoadFolderButton"
                    Content="Load from Default Folder"
                    HorizontalAlignment="Stretch"
                    Click="LoadFolderButton_Click"/>
            <Button x:Name="BrowseButton"
                    Content="Browse..."
                    HorizontalAlignment="Stretch"
                    Click="BrowseButton_Click"/>
        </StackPanel>

        <!-- Session Selection -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,8">
                <TextBlock Text="Session A (Baseline)"
                           FontSize="12"
                           Foreground="#0078D4"
                           FontWeight="SemiBold"/>
                <ComboBox x:Name="SessionACombo"
                          HorizontalAlignment="Stretch"
                          Margin="0,4,0,0"
                          SelectionChanged="SessionACombo_SelectionChanged"
                          PlaceholderText="Select baseline session..."/>
            </StackPanel>

            <StackPanel Grid.Row="1">
                <TextBlock Text="Session B (Compare)"
                           FontSize="12"
                           Foreground="#FF8C00"
                           FontWeight="SemiBold"/>
                <ComboBox x:Name="SessionBCombo"
                          HorizontalAlignment="Stretch"
                          Margin="0,4,0,0"
                          SelectionChanged="SessionBCombo_SelectionChanged"
                          PlaceholderText="Select comparison session..."/>
            </StackPanel>
        </Grid>

        <!-- Session List -->
        <Border Grid.Row="3"
                Background="#1E1E1E"
                CornerRadius="4"
                Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Available Sessions"
                           FontSize="12"
                           Foreground="Gray"
                           Margin="0,0,0,8"/>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="SessionListPanel"
                                Orientation="Vertical"
                                Spacing="4"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Status -->
        <TextBlock x:Name="StatusText"
                   Grid.Row="4"
                   FontSize="10"
                   Foreground="Gray"
                   Margin="0,8,0,0"
                   TextWrapping="Wrap"/>
    </Grid>
</Page>
